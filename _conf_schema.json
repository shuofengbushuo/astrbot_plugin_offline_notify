{
    "enable_notification": {
        "description": "启用下线通知",
        "type": "bool",
        "default": true,
        "hint": "关闭后将停止所有定时通知"
    },
    "global_advance_minutes": {
        "description": "提前通知时间（分钟）",
        "type": "int",
        "default": 5,
        "hint": "在下线前N分钟发送通知，范围 0-30。设为 0 则在下线时间准时发送",
        "minimum": 0,
        "maximum": 30
    },
    "global_float_range": {
        "description": "浮动范围（分钟）",
        "type": "int",
        "default": 2,
        "hint": "通知实际触发时间在 advance_minutes 到 advance_minutes+float_range 之间随机浮动，避免所有通知集中发送。设为 0 则精确触发",
        "minimum": 0,
        "maximum": 10
    },
    "schedules": {
        "description": "定时通知计划",
        "type": "list",
        "hint": "配置不同日期的下线时间和通知规则",
        "default": [
            {
                "name": "工作日下线",
                "day_type": "weekday",
                "offline_time": "23:00",
                "advance_minutes": 5,
                "enabled": true
            },
            {
                "name": "周末下线",
                "day_type": "weekend",
                "offline_time": "23:20",
                "advance_minutes": 5,
                "enabled": true
            }
        ],
        "items": {
            "type": "object",
            "description": "单个通知计划",
            "items": {
                "name": {
                    "type": "string",
                    "description": "计划名称",
                    "default": "默认计划"
                },
                "day_type": {
                    "type": "string",
                    "description": "日期类型",
                    "default": "everyday",
                    "options": ["everyday", "weekday", "weekend", "specific"],
                    "labels": ["每天", "工作日", "周末", "特定日期"]
                },
                "specific_days": {
                    "type": "list",
                    "description": "特定日期（当 day_type 为 specific 时生效）",
                    "default": [],
                    "hint": "填写星期几，如 [\"monday\", \"wednesday\", \"friday\"]",
                    "items": {
                        "type": "string",
                        "description": "星期",
                        "options": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
                        "labels": ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]
                    }
                },
                "offline_time": {
                    "type": "string",
                    "description": "下线时间 (HH:MM)",
                    "default": "23:00",
                    "hint": "24小时制，如 22:30"
                },
                "advance_minutes": {
                    "type": "int",
                    "description": "提前通知分钟数",
                    "default": 5,
                    "hint": "覆盖全局设置，范围 0-30",
                    "minimum": 0,
                    "maximum": 30
                },
                "float_range": {
                    "type": "int",
                    "description": "浮动范围",
                    "default": 0,
                    "hint": "覆盖全局设置。设为 0 则使用全局浮动范围，设为 >0 则覆盖全局值",
                    "minimum": 0,
                    "maximum": 10
                },
                "enabled": {
                    "type": "bool",
                    "description": "启用此计划",
                    "default": true
                }
            }
        }
    },
    "message_template": {
        "description": "通知消息模板",
        "type": "object",
        "hint": "使用 {变量名} 插入动态内容",
        "items": {
            "title_template": {
                "type": "string",
                "description": "标题模板",
                "default": "【AI服务下线通知】",
                "hint": "可用变量: {time}, {date}, {day_of_week}, {countdown_minutes}"
            },
            "body_template": {
                "type": "string",
                "description": "正文模板",
                "default": "注意~{emoji} 小砂糖即将下线休息，明天见！晚安~",
                "hint": "可用变量: {time}, {date}, {day_of_week}, {countdown_minutes}, {emoji}"
            },
            "emoji": {
                "type": "string",
                "description": "表情符号",
                "default": "🌙",
                "hint": "用于正文中的 {emoji} 变量"
            },
            "footer_template": {
                "type": "string",
                "description": "底部模板（可选）",
                "default": "",
                "hint": "留空则不显示，可用变量同正文"
            }
        }
    },
    "llm_generation_config": {
        "description": "LLM 通知内容生成配置",
        "type": "object",
        "hint": "调用对话模型生成多样化、自然的下线通知内容，关闭则使用模板引擎",
        "items": {
            "enable_llm_generation": {
                "type": "bool",
                "description": "启用 LLM 生成通知",
                "default": true,
                "hint": "开启后使用对话模型生成通知内容，关闭则使用下方的消息模板"
            },
            "llm_provider_id": {
                "type": "string",
                "description": "LLM 提供商",
                "default": "",
                "hint": "选择用于生成通知内容的对话模型",
                "_special": "select_provider"
            },
            "llm_timeout": {
                "type": "int",
                "description": "LLM 单次调用超时（秒，内部封顶 40~240）",
                "default": 15,
                "hint": "LLM 生成通知的单次最大等待时间（插件内部会封顶为 40~240s）。由于已默认关闭 DeepSeek 思考模式，正常几秒即可完成，此值主要用于兜底。",
                "minimum": 5,
                "maximum": 60
            },
            "llm_disable_thinking": {
                "type": "bool",
                "description": "关闭 DeepSeek 思考模式（大幅提速）",
                "default": true,
                "hint": "deepseek-v4 系列默认开启「思考/推理」，模型会先花十几秒 reasoning 才吐字，导致通知生成耗时 20s+。开启后仅对本次插件调用临时关闭思考模式（等同旧 deepseek-chat 的非思考路径），耗时降到几秒，且不影响普通聊天。"
            },
            "llm_max_retry": {
                "type": "int",
                "description": "LLM 调用重试次数",
                "default": 2,
                "hint": "首次超时（多半是 AStrBot 的 LLM provider 注册表正在重连）后，等待 llm_retry_delay 秒再试的次数。设为 0 则只试一次不重试",
                "minimum": 0,
                "maximum": 5
            },
            "llm_retry_delay": {
                "type": "int",
                "description": "LLM 重试前等待（秒）",
                "default": 3,
                "hint": "每次重试前等待的秒数，给 AStrBot 的 provider 注册表恢复时间",
                "minimum": 1,
                "maximum": 30
            },
            "fallback_to_template": {
                "type": "bool",
                "description": "失败时回退到模板",
                "default": true,
                "hint": "LLM 生成失败（超时/异常）时，自动使用消息模板作为备用"
            },
            "custom_builtin_prompt": {
                "type": "string",
                "description": "自定义·自动通知提示词",
                "default": "",
                "hint": "【明置编辑】留空则使用内置「砂糖」默认提示词。填写后覆盖默认，用于自动调度触发的下线通知。支持占位符：{date} {day_of_week} {time_context} {offline_time} {countdown_minutes}。多套提示词可用 /下线通知 提示词 命令存成命名方案、互不干扰地切换。"
            },
            "custom_manual_prompt": {
                "type": "string",
                "description": "自定义·手动生成提示词",
                "default": "",
                "hint": "【明置编辑】留空则使用内置「砂糖」默认提示词。填写后覆盖默认，用于 /下线通知 生成 手动触发场景。支持占位符同上。"
            }
        }
    },
    "target_groups": {
        "description": "目标通知群组",
        "type": "list",
        "hint": "填写需要接收通知的群号，留空则不发送",
        "default": [],
        "items": {
            "type": "object",
            "description": "群组配置",
            "items": {
                "group_id": {
                    "type": "string",
                    "description": "QQ群号",
                    "default": ""
                },
                "group_name": {
                    "type": "string",
                    "description": "群名称（备注用）",
                    "default": ""
                },
                "enabled": {
                    "type": "bool",
                    "description": "启用此群组通知",
                    "default": true
                }
            }
        }
    },
    "retry_config": {
        "description": "发送失败重试配置",
        "type": "object",
        "hint": "消息发送失败时的重试策略",
        "items": {
            "max_retries": {
                "type": "int",
                "description": "最大重试次数",
                "default": 3,
                "hint": "每次重试间隔递增",
                "minimum": 0,
                "maximum": 10
            },
            "retry_interval_base": {
                "type": "int",
                "description": "重试基础间隔（秒）",
                "default": 10,
                "hint": "实际间隔 = 基础间隔 × 重试次数",
                "minimum": 5,
                "maximum": 120
            }
        }
    },
    "monitor_config": {
        "description": "自我监控配置",
        "type": "object",
        "hint": "定时任务健康检查和告警",
        "items": {
            "enable_monitor": {
                "type": "bool",
                "description": "启用自我监控",
                "default": true
            },
            "heartbeat_interval": {
                "type": "int",
                "description": "心跳检测间隔（秒）",
                "default": 300,
                "hint": "每N秒检查一次调度器状态",
                "minimum": 60,
                "maximum": 3600
            },
            "alert_admin_group": {
                "type": "string",
                "description": "告警通知群号",
                "default": "",
                "hint": "当调度器异常时向此群发送告警，留空则仅记录日志"
            },
            "alert_qq": {
                "type": "string",
                "description": "告警通知QQ号",
                "default": "",
                "hint": "当调度器异常时向此QQ号私聊发送告警，留空则不发送私聊告警"
            }
        }
    },
    "enable_manual_command": {
        "description": "启用手动命令",
        "type": "bool",
        "default": true,
        "hint": "允许通过 /下线通知 命令手动触发通知和预览"
    }
}